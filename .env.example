# ── Core ─────────────────────────────────────────────────────────────
DATABASE_URL=postgres://app:app@localhost:5432/appoint_dev
# Public origin of the app (used for links in emails, OAuth callbacks, CSRF origin checks)
APP_URL=http://localhost:3000
# Random 32+ char string. Used to hash IPs for audit/rate-limit keys.
APP_SECRET=change-me-to-a-long-random-string-please
# Shared secret for /api/internal/cron when running jobs from an external scheduler
CRON_SECRET=

# ── Storage ──────────────────────────────────────────────────────────
# local: disk under STORAGE_DIR (single server with a persistent volume)
# s3: any S3-compatible bucket (AWS S3, Cloudflare R2, MinIO). Keep it private —
#     files are always served through /media with access checks.
STORAGE_DRIVER=local
STORAGE_DIR=./storage
S3_BUCKET=
S3_REGION=auto
S3_ENDPOINT=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# ── Email (optional; without a key, emails are logged to the console) ─
RESEND_API_KEY=
EMAIL_FROM="Kept <hello@example.com>"

# ── SMS (optional) ───────────────────────────────────────────────────
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# ── OAuth (optional; buttons only appear when configured) ────────────
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ── Payments (optional; without keys only pay-in-person is offered) ──
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
# Customer-facing service fee in basis points (0 = none). Always shown before checkout.
PLATFORM_CUSTOMER_FEE_BPS=0

# ── Maps (optional) ──────────────────────────────────────────────────
# Nominatim-compatible geocoder used server-side for address/city lookup
GEOCODER_URL=
NEXT_PUBLIC_MAP_TILE_URL=https://tile.openstreetmap.org/{z}/{x}/{y}.png
NEXT_PUBLIC_MAP_ATTRIBUTION="© OpenStreetMap contributors"

# Client IP for rate limiting. Behind one reverse proxy that appends to X-Forwarded-For (nginx, a load balancer): TRUSTED_PROXY_HOPS=1.
# If your edge sets a dedicated header (Cloudflare: cf-connecting-ip, Vercel: x-vercel-forwarded-for), set CLIENT_IP_HEADER instead.
TRUSTED_PROXY_HOPS=1
CLIENT_IP_HEADER=

# ── Assistant (optional) ─────────────────────────────────────────────
# Without a key, "Ask Kept" understands searches and navigation locally (English & Spanish).
# With a key it also answers open questions in any language, using the same real search tools.
ANTHROPIC_API_KEY=
ASSISTANT_MODEL=claude-sonnet-5-5
